{
  "id": "arenaIndesignLink",
  "name": "Arena Link",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "arenaPanelId",
      "label": "panelLabel",
      "description": "panelDescription",
      "minimumSize": {
        "width": 280,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 520
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "assets/icons/dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "assets/icons/light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false,
    "network": {
      "domains": [
        "https://*.e2b.app"
      ]
    }
  },
  "featureFlags": {
    "enableSWCSupport": true
  },
  "strings": {
    "pluginName": {
      "default": "Arena Link"
    },
    "panelLabel": {
      "default": "Arena Link"
    },
    "panelDescription": {
      "default": "Connects InDesign to the Arena agent"
    }
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "assets/icons/arena_dark_theme_logo.svg",
      "scale": [
        1
      ],
      "theme": [
        "darkest",
        "dark",
        "medium"
      ],
      "species": [
        "pluginList"
      ]
    },
    {
      "width": 48,
      "height": 48,
      "path": "assets/icons/arena_light_theme_logo.svg",
      "scale": [
        1
      ],
      "theme": [
        "lightest",
        "light"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
